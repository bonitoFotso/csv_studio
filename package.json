{
  "name": "csv-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/core typecheck && bun run --cwd apps/web build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples": "bun run apps/web/scripts/generateSamples.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitest/ui": "^4.1.10",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
